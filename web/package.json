{
  "name": "autoshorts-web",
  "version": "0.1.0",
  "private": true,
  "description": "Операторская консоль Auto Shorts (docs/ARCHITECTURE.md §7). Статический экспорт, ноль внешних ресурсов.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 18301",
    "dev:mock": "NEXT_PUBLIC_API_MOCKING=1 next dev -H 127.0.0.1 -p 18301",
    "build": "next build",
    "postbuild": "node scripts/postbuild.mjs",
    "build:export": "NEXT_EXPORT=1 npm run build && node scripts/check-no-external.mjs",
    "typecheck": "next typegen && tsc --noEmit -p tsconfig.json",
    "test:unit": "playwright test -c playwright.unit.config.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen:api": "cd .. && .venv/bin/python scripts/export_openapi.py --ts",
    "check:external": "node scripts/check-no-external.mjs",
    "serve:out": "node scripts/serve-static.mjs",
    "e2e": "playwright test",
    "e2e:mock": "NEXT_PUBLIC_API_MOCKING=1 NEXT_EXPORT=1 NEXT_EXPORT_DIR=out-mock npm run build && E2E_STATIC_DIR=out-mock playwright test"
  },
  "dependencies": {
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@date-fns/tz": "^1.5.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "@hookform/resolvers": "^5.9.1",
    "@lezer/highlight": "^1.2.4",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/react-virtual": "^3.14.13",
    "@uiw/react-codemirror": "^4.25.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "nuqs": "^2.10.1",
    "openapi-fetch": "^0.17.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.89.0",
    "react-hotkeys-hook": "^5.3.3",
    "react-rnd": "^10.5.3",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tus-js-client": "4.3.1",
    "wavesurfer.js": "7.12.12",
    "yaml": "^2.9.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "msw": "^2.15.0",
    "openapi-typescript": "7.13.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^5"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
