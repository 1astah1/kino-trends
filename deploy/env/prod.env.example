# Auto Shorts — образец /opt/auto-shorts/.env на VPS (docs/ARCHITECTURE.md §8.3, §8.5).
# Файл читают systemd (EnvironmentFile во всех юнитах deploy/systemd) и core/config.py.
#   sudo install -o root -g autoshorts -m 0640 deploy/env/prod.env.example /opt/auto-shorts/.env
# Формат systemd: KEY=VALUE, без export, без кавычек вокруг простых значений и БЕЗ комментариев
# в конце строки (systemd сделал бы комментарий частью значения).
# Секреты провайдеров (FAL_API_KEY, LLM_API_KEY, TELEGRAM_BOT_TOKEN, …) в v1 живут в таблице secrets
# и заводятся через админку; здесь только инфраструктура.

APP_ENV=prod
# Пароль роли — свой; база должна быть отдельной от других проектов на этом сервере.
DATABASE_URL=postgresql://autoshorts:REPLACE_WITH_DB_PASSWORD@127.0.0.1:5432/autoshorts
MEDIA_ROOT=/var/lib/autoshorts/media
MODELS_DIR=/var/lib/autoshorts/models
BACKUP_DIR=/var/backups/autoshorts
# Ключи Fernet в отдельном файле (root:autoshorts 0640), по ключу на строку, первый шифрует:
#   .venv/bin/python -c "from autoshorts.core.security import generate_fernet_key as g; print(g())" | sudo tee /etc/autoshorts/as_secrets_key
AS_SECRETS_KEY_FILE=/etc/autoshorts/as_secrets_key
# openssl rand -hex 32. Смена соли обнуляет уникальных посетителей: не менять без нужды.
REDIRECT_SALT=
SESSION_COOKIE_SECURE=true
ADMIN_BASE_URL=https://admin.example.com
PUBLIC_BASE_URL=https://u.example.com
# dedicated_small — отдельный VPS (ставится вместе с drop-in'ами deploy/systemd/profiles/dedicated_small);
# shared_dev — если прод делит машину с другими проектами (тогда drop-in'ы не ставить).
RESOURCE_PROFILE=dedicated_small
LOG_LEVEL=INFO
LOG_FORMAT=json

# Необязательное.
# ASGI-приложение редиректора; до M3 можно autoshorts.webapp.redirect:app
# AS_PUBLIC_APP=autoshorts.public.app:app
# Слоты лёгкого воркера (по умолчанию из юнита: 2, в dedicated_small — 3)
# AS_LIGHT_CONCURRENCY=3
# Ротация дампов deploy/backup.sh
# AS_BACKUP_KEEP_DAILY=7
# AS_BACKUP_KEEP_WEEKLY=4
# Осознанно разрешить mock-провайдеры в prod (M0). Обычно не задаётся.
# ALLOW_MOCK_IN_PROD=
