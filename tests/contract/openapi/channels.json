      "PublishingPlan": {
        "additionalProperties": false,
        "properties": {
          "category_id": {
            "anyOf": [
              {
                "pattern": "^[0-9]{1,3}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Категория YouTube: 1 — фильмы и анимация, 22 — люди и блоги (умолч.)",
            "title": "Category Id"
          },
          "clips_per_day": {
            "anyOf": [
              {
                "maximum": 50.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Нарезок чужого видео в сутки (остальные слоты — под своё); пусто — без ограничения",
            "title": "Clips Per Day"
          },
          "language": {
            "anyOf": [
              {
                "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})?$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Язык ролика и звука (BCP-47, например ru)",
            "title": "Language"
          },
          "mode": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PublishMode"
              },
              {
                "type": "null"
              }
            ],
            "description": "manual — пакет к ручной заливке; auto — система заливает сама по слотам"
          },
          "privacy": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/VideoPrivacy"
              },
              {
                "type": "null"
              }
            ],
            "description": "Приватность автозалива (public по умолчанию)"
          },
          "slots": {
            "anyOf": [
              {
                "items": {
