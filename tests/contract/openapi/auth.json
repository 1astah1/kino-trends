{
  "components": {
    "schemas": {
      "ApiToken": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "expires_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "last_used_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Used At"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "prefix": {
            "description": "Видимая часть токена `ast_xxxx` для опознания",
            "title": "Prefix",
            "type": "string"
          },
          "revoked_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Revoked At"
          },
          "scopes": {
            "items": {
              "$ref": "#/components/schemas/ApiTokenScope"
            },
            "title": "Scopes",
            "type": "array"
          }
        },
        "required": [
          "id",
          "name",
          "prefix",
          "scopes",
          "created_at",
          "last_used_at",
          "expires_at",
          "revoked_at"
        ],
        "title": "ApiToken",
        "type": "object"
      },
      "ApiTokenCreate": {
        "additionalProperties": false,
        "properties": {
          "expires_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At"
          },
          "name": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "scopes": {
            "items": {
              "$ref": "#/components/schemas/ApiTokenScope"
            },
            "minItems": 1,
            "title": "Scopes",
            "type": "array"
          }
        },
        "required": [
          "name",
          "scopes"
        ],
        "title": "ApiTokenCreate",
        "type": "object"
      },
      "ApiTokenCreated": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "token": {
            "description": "Полный токен `ast_…`; отдаётся один раз",
            "title": "Token",
            "type": "string"
          }
        },
        "required": [
          "id",
          "token"
        ],
        "title": "ApiTokenCreated",
        "type": "object"
      },
      "ApiTokenList": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ApiToken"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "ApiTokenList",
        "type": "object"
      },
      "ApiTokenScope": {
        "enum": [
          "read",
          "ingest"
        ],
        "title": "ApiTokenScope",
        "type": "string"
      },
      "AuthState": {
        "description": "Ответ `POST /auth/login` и `GET /auth/me`. `csrf_token` фронт шлёт в `X-CSRF-Token`.",
        "properties": {
          "csrf_token": {
            "title": "Csrf Token",
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/CurrentUser"
          }
        },
        "required": [
          "user",
          "csrf_token"
        ],
        "title": "AuthState",
        "type": "object"
      },
      "ChangePasswordRequest": {
        "additionalProperties": false,
        "properties": {
          "current_password": {
            "maxLength": 1024,
            "minLength": 1,
            "title": "Current Password",
            "type": "string"
          },
          "new_password": {
            "maxLength": 1024,
            "minLength": 12,
            "title": "New Password",
            "type": "string"
          }
        },
        "required": [
          "current_password",
          "new_password"
        ],
        "title": "ChangePasswordRequest",
        "type": "object"
      },
      "CurrentUser": {
        "properties": {
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "login": {
            "title": "Login",
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "tg_user_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tg User Id"
          }
        },
        "required": [
          "id",
          "login",
          "display_name",
          "role",
          "tg_user_id"
        ],
        "title": "CurrentUser",
        "type": "object"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "description": "Машинный код ошибки, латиница snake_case",
            "examples": [
              "job_not_found"
            ],
            "title": "Code",
            "type": "string"
          },
          "details": {
            "additionalProperties": true,
            "description": "Подробности; для 422 — `errors: [{loc, msg, type}]`",
            "title": "Details",
            "type": "object"
          },
          "message": {
            "description": "Сообщение для человека (по-русски)",
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorResponse": {
        "description": "Единый формат ошибки: `{\"error\": {\"code\", \"message\", \"details\"}}`.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "LoginRequest": {
        "additionalProperties": false,
        "properties": {
          "login": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Login",
            "type": "string"
          },
          "password": {
            "maxLength": 1024,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "login",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "Role": {
        "enum": [
          "admin",
          "operator",
          "viewer"
        ],
        "title": "Role",
        "type": "string"
      },
      "SessionItem": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "current": {
            "title": "Current",
            "type": "boolean"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "last_seen_at": {
            "format": "date-time",
            "title": "Last Seen At",
            "type": "string"
          },
          "user_agent": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "User Agent"
          }
        },
        "required": [
          "id",
          "created_at",
          "last_seen_at",
          "user_agent",
          "current"
        ],
        "title": "SessionItem",
        "type": "object"
      },
      "SessionList": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/SessionItem"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "SessionList",
        "type": "object"
      }
    }
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/api-tokens": {
      "get": {
        "operationId": "auth_api_tokens_list",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiTokenList"
                }
              }
            },
            "description": "Successful Response"
          },
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Ошибка запроса: `{error: {code, message, details}}`"
          },
          "5XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Ошибка сервера или 501 not_implemented"
          }
        },
        "summary": "Мои API-токены",
        "tags": [
          "auth"
        ]
      },
      "post": {
        "operationId": "auth_api_tokens_create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApiTokenCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiTokenCreated"
                }
              }
            },
            "description": "Successful Response"
          },
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Ошибка запроса: `{error: {code, message, details}}`"
          },
          "5XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Ошибка сервера или 501 not_implemented"
          }
        },
        "summary": "Выпустить токен (значение отдаётся один раз)",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/api-tokens/{token_id}": {
      "delete": {
        "operationId": "auth_api_tokens_revoke",
        "parameters": [
          {
            "in": "path",
            "name": "token_id",
            "required": true,
            "schema": {
              "title": "Token Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Ошибка запроса: `{error: {code, message, details}}`"
          },
          "5XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Ошибка сервера или 501 not_implemented"
          }
        },
        "summary": "Отозвать токен",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/change-password": {
      "post": {
        "operationId": "auth_change_password",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Ошибка запроса: `{error: {code, message, details}}`"
          },
          "5XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Ошибка сервера или 501 not_implemented"
          }
        },
        "summary": "Смена пароля (остальные сессии отзываются)",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "operationId": "auth_login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthState"
                }
              }
            },
            "description": "Successful Response"
          },
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Ошибка запроса: `{error: {code, message, details}}`"
          },
          "5XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Ошибка сервера или 501 not_implemented"
          }
        },
        "summary": "Вход (ставит cookie as_session, as_csrf)",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "auth_logout",
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Ошибка запроса: `{error: {code, message, details}}`"
          },
          "5XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Ошибка сервера или 501 not_implemented"
          }
        },
        "summary": "Выход",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "operationId": "auth_me",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthState"
                }
              }
            },
            "description": "Successful Response"
          },
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Ошибка запроса: `{error: {code, message, details}}`"
          },
          "5XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Ошибка сервера или 501 not_implemented"
          }
        },
        "summary": "Текущий пользователь и CSRF-токен",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/sessions": {
      "get": {
        "operationId": "auth_sessions_list",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionList"
                }
              }
            },
            "description": "Successful Response"
          },
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Ошибка запроса: `{error: {code, message, details}}`"
          },
          "5XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Ошибка сервера или 501 not_implemented"
          }
        },
        "summary": "Мои сессии",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/sessions/{session_id}": {
      "delete": {
        "operationId": "auth_sessions_revoke",
        "parameters": [
          {
            "in": "path",
            "name": "session_id",
            "required": true,
            "schema": {
              "title": "Session Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Ошибка запроса: `{error: {code, message, details}}`"
          },
          "5XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Ошибка сервера или 501 not_implemented"
          }
        },
        "summary": "Отозвать сессию",
        "tags": [
          "auth"
        ]
      }
    }
  },
  "tag": "auth"
}
