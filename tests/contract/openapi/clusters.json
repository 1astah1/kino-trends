{
  "components": {
    "schemas": {
      "Cluster": {
        "properties": {
          "channels_count": {
            "title": "Channels Count",
            "type": "integer"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "youtube_api_key_secret": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Имя секрета с ключом YouTube Data API куста",
            "title": "Youtube Api Key Secret"
          },
          "youtube_oauth_client_secret": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Youtube Oauth Client Secret"
          }
        },
        "required": [
          "id",
          "title",
          "notes",
          "youtube_api_key_secret",
          "youtube_oauth_client_secret",
          "channels_count",
          "created_at"
        ],
        "title": "Cluster",
        "type": "object"
      },
      "ClusterCreate": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "pattern": "^[a-z0-9][a-z0-9_-]{1,39}$",
            "title": "Id",
            "type": "string"
          },
          "notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          },
          "title": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title"
        ],
        "title": "ClusterCreate",
        "type": "object"
      },
      "ClusterList": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Cluster"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "ClusterList",
        "type": "object"
      },
      "ClusterPatch": {
        "additionalProperties": false,
        "properties": {
          "notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          },
          "title": {
            "anyOf": [
              {
                "maxLength": 100,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "youtube_api_key_secret": {
            "anyOf": [
              {
                "pattern": "^[A-Z][A-Z0-9_]{2,63}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Youtube Api Key Secret"
          },
          "youtube_oauth_client_secret": {
            "anyOf": [
              {
                "pattern": "^[A-Z][A-Z0-9_]{2,63}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Youtube Oauth Client Secret"
          }
        },
        "title": "ClusterPatch",
        "type": "object"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "description": "Машинный код ошибки, латиница snake_case",
            "examples": [
              "job_not_found"
            ],
            "title": "Code",
            "type": "string"
          },
          "details": {
            "additionalProperties": true,
            "description": "Подробности; для 422 — `errors: [{loc, msg, type}]`",
            "title": "Details",
            "type": "object"
          },
          "message": {
            "description": "Сообщение для человека (по-русски)",
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorResponse": {
        "description": "Единый формат ошибки: `{\"error\": {\"code\", \"message\", \"details\"}}`.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      }
    }
  },
  "openapi": "3.1.0",
  "paths": {
