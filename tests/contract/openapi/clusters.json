        "operationId": "clusters_list",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClusterList"
                }
              }
            },
            "description": "Successful Response"
          },
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Ошибка запроса: `{error: {code, message, details}}`"
          },
          "5XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Ошибка сервера или 501 not_implemented"
          }
        },
        "summary": "Кусты",
        "tags": [
          "clusters"
        ]
      },
      "post": {
        "operationId": "clusters_create",
        "requestBody": {
          "content": {
