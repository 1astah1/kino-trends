{
  "components": {
    "schemas": {
      "CleanupPreview": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/CleanupPreviewItem"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "CleanupPreview",
        "type": "object"
      },
      "CleanupPreviewItem": {
        "properties": {
          "bytes": {
            "title": "Bytes",
            "type": "integer"
          },
          "category": {
            "description": "work_artifacts, rejected_media, proxies, originals, tus_parts, task_logs, tmp",
            "title": "Category",
            "type": "string"
          },
          "files": {
            "title": "Files",
            "type": "integer"
          }
        },
        "required": [
          "category",
          "files",
          "bytes"
        ],
        "title": "CleanupPreviewItem",
        "type": "object"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "description": "Машинный код ошибки, латиница snake_case",
            "examples": [
              "job_not_found"
            ],
            "title": "Code",
            "type": "string"
          },
          "details": {
            "additionalProperties": true,
            "description": "Подробности; для 422 — `errors: [{loc, msg, type}]`",
            "title": "Details",
            "type": "object"
          },
          "message": {
            "description": "Сообщение для человека (по-русски)",
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorResponse": {
        "description": "Единый формат ошибки: `{\"error\": {\"code\", \"message\", \"details\"}}`.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "TaskAccepted": {
        "description": "202: работа поставлена в очередь.",
        "properties": {
          "task_id": {
            "title": "Task Id",
            "type": "integer"
          }
        },
        "required": [
          "task_id"
        ],
        "title": "TaskAccepted",
        "type": "object"
      }
    }
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/maintenance/cleanup": {
      "post": {
        "operationId": "maintenance_cleanup",
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskAccepted"
                }
              }
            },
            "description": "Successful Response"
          },
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Ошибка запроса: `{error: {code, message, details}}`"
          },
          "5XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Ошибка сервера или 501 not_implemented"
          }
        },
        "summary": "Запустить уборку (admin)",
        "tags": [
          "maintenance"
        ]
      }
    },
    "/api/v1/maintenance/cleanup-preview": {
      "post": {
        "operationId": "maintenance_cleanup_preview",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CleanupPreview"
                }
              }
            },
            "description": "Successful Response"
          },
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Ошибка запроса: `{error: {code, message, details}}`"
          },
          "5XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Ошибка сервера или 501 not_implemented"
          }
        },
        "summary": "Оценить уборку файлов",
        "tags": [
          "maintenance"
        ]
      }
    }
  },
  "tag": "maintenance"
}
