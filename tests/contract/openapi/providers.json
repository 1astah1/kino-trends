{
  "components": {
    "schemas": {
      "ErrorBody": {
        "properties": {
          "code": {
            "description": "Машинный код ошибки, латиница snake_case",
            "examples": [
              "job_not_found"
            ],
            "title": "Code",
            "type": "string"
          },
          "details": {
            "additionalProperties": true,
            "description": "Подробности; для 422 — `errors: [{loc, msg, type}]`",
            "title": "Details",
            "type": "object"
          },
          "message": {
            "description": "Сообщение для человека (по-русски)",
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorResponse": {
        "description": "Единый формат ошибки: `{\"error\": {\"code\", \"message\", \"details\"}}`.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "Provider": {
        "properties": {
          "adapter": {
            "description": "Модуль адаптера, напр. llm.openai_compat",
            "title": "Adapter",
            "type": "string"
          },
          "enabled": {
            "title": "Enabled",
            "type": "boolean"
          },
          "is_default": {
            "title": "Is Default",
            "type": "boolean"
          },
          "key": {
            "title": "Key",
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/ProviderKind"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "last_error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Error"
          },
          "last_ok_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Ok At"
          },
          "license_note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "License Note"
          },
          "params": {
            "additionalProperties": true,
            "title": "Params",
            "type": "object"
          },
          "price": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ProviderPrice"
              },
              {
                "type": "null"
              }
            ]
          },
          "resource_class": {
            "$ref": "#/components/schemas/ResourceClass"
          },
          "secret_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Secret Name"
          },
          "secret_set": {
            "title": "Secret Set",
            "type": "boolean"
          }
        },
        "required": [
          "key",
          "kind",
          "adapter",
          "label",
          "enabled",
          "is_default",
          "params",
          "secret_name",
          "secret_set",
          "price",
          "license_note",
          "resource_class",
          "last_ok_at",
          "last_error"
        ],
        "title": "Provider",
        "type": "object"
      },
      "ProviderKind": {
        "enum": [
          "llm",
          "tts",
          "image",
          "asr",
          "vision",
          "faces"
        ],
        "title": "ProviderKind",
        "type": "string"
      },
      "ProviderList": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Provider"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "ProviderList",
        "type": "object"
      },
      "ProviderPrice": {
        "properties": {
          "unit": {
            "description": "call | image | 1k_tokens | audio_minute | char …",
            "title": "Unit",
            "type": "string"
          },
          "usd": {
            "title": "Usd",
            "type": "number"
          }
        },
        "required": [
          "unit",
          "usd"
        ],
        "title": "ProviderPrice",
        "type": "object"
      },
      "ProviderTestResult": {
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "latency_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latency Ms"
          },
          "ok": {
            "title": "Ok",
            "type": "boolean"
          }
        },
        "required": [
          "ok",
          "latency_ms",
          "detail"
        ],
        "title": "ProviderTestResult",
        "type": "object"
      },
      "ProviderUpdate": {
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "title": "Enabled",
            "type": "boolean"
          },
          "is_default": {
            "title": "Is Default",
            "type": "boolean"
          },
          "params": {
            "additionalProperties": true,
            "title": "Params",
            "type": "object"
          },
          "secret_name": {
            "anyOf": [
              {
                "pattern": "^[A-Z][A-Z0-9_]{2,63}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Secret Name"
          }
        },
        "required": [
          "enabled",
          "is_default"
        ],
        "title": "ProviderUpdate",
        "type": "object"
      },
      "ResourceClass": {
        "enum": [
          "heavy",
          "light"
        ],
        "title": "ResourceClass",
        "type": "string"
      }
    }
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/providers": {
      "get": {
        "operationId": "providers_list",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderList"
                }
              }
            },
            "description": "Successful Response"
          },
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Ошибка запроса: `{error: {code, message, details}}`"
          },
          "5XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Ошибка сервера или 501 not_implemented"
          }
        },
        "summary": "Реестр провайдеров и конфиги",
        "tags": [
          "providers"
        ]
      }
    },
    "/api/v1/providers/{provider_key}": {
      "put": {
        "operationId": "providers_update",
        "parameters": [
          {
            "in": "path",
            "name": "provider_key",
            "required": true,
            "schema": {
              "pattern": "^[a-z0-9_]{2,63}$",
              "title": "Provider Key",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProviderUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Provider"
                }
              }
            },
            "description": "Successful Response"
          },
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Ошибка запроса: `{error: {code, message, details}}`"
          },
          "5XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Ошибка сервера или 501 not_implemented"
          }
        },
        "summary": "Конфиг провайдера",
        "tags": [
          "providers"
        ]
      }
    },
    "/api/v1/providers/{provider_key}/test": {
      "post": {
        "operationId": "providers_test",
        "parameters": [
          {
            "in": "path",
            "name": "provider_key",
            "required": true,
            "schema": {
              "pattern": "^[a-z0-9_]{2,63}$",
              "title": "Provider Key",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderTestResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Ошибка запроса: `{error: {code, message, details}}`"
          },
          "5XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Ошибка сервера или 501 not_implemented"
          }
        },
        "summary": "Проверка связи",
        "tags": [
          "providers"
        ]
      }
    }
  },
  "tag": "providers"
}
