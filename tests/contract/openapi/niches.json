{
  "components": {
    "schemas": {
      "Body_niches_import_yaml": {
        "properties": {
          "file": {
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "type": "string"
          },
          "mode": {
            "default": "create",
            "enum": [
              "create",
              "replace"
            ],
            "title": "Mode",
            "type": "string"
          }
        },
        "required": [
          "file"
        ],
        "title": "Body_niches_import_yaml",
        "type": "object"
      },
      "ConfigIssue": {
        "properties": {
          "msg": {
            "title": "Msg",
            "type": "string"
          },
          "path": {
            "description": "Путь в конфиге: script.hooks[2].text",
            "title": "Path",
            "type": "string"
          }
        },
        "required": [
          "path",
          "msg"
        ],
        "title": "ConfigIssue",
        "type": "object"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "description": "Машинный код ошибки, латиница snake_case",
            "examples": [
              "job_not_found"
            ],
            "title": "Code",
            "type": "string"
          },
          "details": {
            "additionalProperties": true,
            "description": "Подробности; для 422 — `errors: [{loc, msg, type}]`",
            "title": "Details",
            "type": "object"
          },
          "message": {
            "description": "Сообщение для человека (по-русски)",
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorResponse": {
        "description": "Единый формат ошибки: `{\"error\": {\"code\", \"message\", \"details\"}}`.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "Niche": {
        "properties": {
          "config": {
            "additionalProperties": true,
            "description": "NicheConfig",
            "title": "Config",
            "type": "object"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "current_version": {
            "description": "Передавать как expected_version в PUT",
            "title": "Current Version",
            "type": "integer"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/NicheStatus"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          },
          "used_by_channels": {
            "items": {
              "type": "string"
            },
            "title": "Used By Channels",
            "type": "array"
          }
        },
        "required": [
          "id",
          "label",
          "status",
          "current_version",
          "config",
          "used_by_channels",
          "created_at",
          "updated_at"
        ],
        "title": "Niche",
        "type": "object"
      },
      "NicheCreate": {
        "additionalProperties": false,
        "properties": {
          "clone_from": {
            "anyOf": [
              {
                "pattern": "^[a-z0-9][a-z0-9_-]{1,39}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Скопировать конфиг текущей версии другой ниши",
            "title": "Clone From"
          },
          "config": {
            "additionalProperties": true,
            "title": "Config",
            "type": "object"
          },
          "id": {
            "pattern": "^[a-z0-9][a-z0-9_-]{1,39}$",
            "title": "Id",
            "type": "string"
          },
          "label": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Label",
            "type": "string"
          }
        },
        "required": [
          "id",
          "label"
        ],
        "title": "NicheCreate",
        "type": "object"
      },
      "NichePage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/NicheRow"
            },
            "title": "Items",
            "type": "array"
          },
          "limit": {
            "title": "Limit",
            "type": "integer"
          },
          "offset": {
            "title": "Offset",
            "type": "integer"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "total",
          "limit",
          "offset",
          "items"
        ],
        "title": "NichePage",
        "type": "object"
      },
      "NichePatch": {
        "additionalProperties": false,
        "properties": {
          "label": {
            "anyOf": [
              {
                "maxLength": 100,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Label"
          },
          "status": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/NicheStatus"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "title": "NichePatch",
        "type": "object"
      },
      "NicheRow": {
        "properties": {
          "current_version": {
            "title": "Current Version",
            "type": "integer"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/NicheStatus"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          },
          "used_by_channels": {
            "items": {
              "type": "string"
            },
            "title": "Used By Channels",
            "type": "array"
          }
        },
        "required": [
          "id",
          "label",
          "status",
          "current_version",
          "used_by_channels",
          "updated_at"
        ],
        "title": "NicheRow",
        "type": "object"
      },
      "NicheStatus": {
        "enum": [
          "active",
          "archived",
          "needs_import"
        ],
        "title": "NicheStatus",
        "type": "string"
      },
      "NicheValidateRequest": {
        "additionalProperties": false,
        "properties": {
          "config": {
            "additionalProperties": true,
            "title": "Config",
            "type": "object"
          }
        },
        "required": [
          "config"
        ],
        "title": "NicheValidateRequest",
        "type": "object"
      },
      "NicheValidateResponse": {
        "properties": {
          "errors": {
            "items": {
              "$ref": "#/components/schemas/ConfigIssue"
            },
            "title": "Errors",
            "type": "array"
          },
          "ok": {
            "title": "Ok",
            "type": "boolean"
          },
          "warnings": {
            "items": {
              "$ref": "#/components/schemas/ConfigIssue"
            },
            "title": "Warnings",
            "type": "array"
          }
        },
        "required": [
          "ok",
          "errors",
          "warnings"
        ],
        "title": "NicheValidateResponse",
        "type": "object"
      },
      "NicheVersionConfig": {
        "properties": {
          "config": {
            "additionalProperties": true,
            "title": "Config",
            "type": "object"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "version",
          "config"
        ],
        "title": "NicheVersionConfig",
        "type": "object"
      },
      "NicheVersionItem": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "created_by": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Created By"
          },
          "source": {
            "$ref": "#/components/schemas/NicheVersionSource"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "version",
          "source",
          "created_by",
          "created_at"
        ],
        "title": "NicheVersionItem",
        "type": "object"
      },
      "NicheVersionList": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/NicheVersionItem"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "NicheVersionList",
        "type": "object"
      },
      "NicheVersionPut": {
        "additionalProperties": false,
        "properties": {
          "config": {
            "additionalProperties": true,
            "title": "Config",
            "type": "object"
          },
          "expected_version": {
            "minimum": 0.0,
            "title": "Expected Version",
            "type": "integer"
          }
        },
        "required": [
          "config",
          "expected_version"
        ],
        "title": "NicheVersionPut",
        "type": "object"
      },
      "NicheVersionSource": {
        "enum": [
          "ui",
          "yaml_import",
          "migration"
        ],
        "title": "NicheVersionSource",
        "type": "string"
      }
    }
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/niches": {
      "get": {
        "operationId": "niches_list",
        "parameters": [
          {
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/NicheStatus"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            }
          },
          {
            "description": "Размер страницы, ≤ 200",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "description": "Размер страницы, ≤ 200",
              "maximum": 200,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "description": "Смещение",
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "description": "Смещение",
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NichePage"
                }
              }
            },
            "description": "Successful Response"
          },
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Ошибка запроса: `{error: {code, message, details}}`"
          },
          "5XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Ошибка сервера или 501 not_implemented"
          }
        },
        "summary": "Ниши",
        "tags": [
          "niches"
        ]
      },
      "post": {
        "operationId": "niches_create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NicheCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Niche"
                }
              }
            },
            "description": "Successful Response"
          },
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Ошибка запроса: `{error: {code, message, details}}`"
          },
          "5XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Ошибка сервера или 501 not_implemented"
          }
        },
        "summary": "Создать нишу или клонировать",
        "tags": [
          "niches"
        ]
      }
    },
