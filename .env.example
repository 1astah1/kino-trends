# Auto Shorts — образец .env для разработки (docs/ARCHITECTURE.md §8.3, §8.4).
# Скопировать в .env (в git не коммитится) и заполнить. Для прода — deploy/env/prod.env.example.
# Имена переменных — только латиница. Комментарии — отдельными строками: systemd (EnvironmentFile)
# не понимает комментариев в конце строки, а этот файл на стендах читается и им.

# ════════ Инфраструктура v1 (src/autoshorts/core/config.py) ════════

# dev | test | stage | prod. В prod mock-провайдеры запрещены (§3.3 п. 1), cookie сессии — Secure.
APP_ENV=dev
# База. На общем боксе "autoshorts" — legacy-данные старого конвейера: v1 гоняйте в отдельной базе
# (режим B, AS_DEV_DATABASE_URL ниже) и не запускайте autoshorts-admin migrate против legacy-базы.
DATABASE_URL=postgresql://autoshorts:autoshorts@127.0.0.1:5432/autoshorts
# Относительные пути считаются от корня репозитория.
MEDIA_ROOT=./var/media
MODELS_DIR=./var/models
BACKUP_DIR=./var/backups
# Ключ Fernet для таблицы secrets (через запятую — несколько, первый шифрует; MultiFernet для ротации).
# Сгенерировать: .venv/bin/python -c "from autoshorts.core.security import generate_fernet_key as g; print(g())"
AS_SECRETS_KEY=
# Либо путь к файлу с ключами (читается, если AS_SECRETS_KEY пуст):
# AS_SECRETS_KEY_FILE=
# Соль visitor_key и хешей в журнале кликов (§5.3): случайная строка, например openssl rand -hex 32
REDIRECT_SALT=
# Пусто — Secure-cookie только при APP_ENV=prod
SESSION_COOKIE_SECURE=
ADMIN_BASE_URL=http://127.0.0.1:18301
PUBLIC_BASE_URL=http://127.0.0.1:18302
# shared_dev (общая машина) | dedicated_small (отдельный VPS), §8.1
RESOURCE_PROFILE=shared_dev
LOG_LEVEL=INFO
# json | text; пусто — json в prod, text в остальных
LOG_FORMAT=
# M0: осознанно разрешить mock-провайдеры при APP_ENV=prod (1/true/yes/on). Обычно пусто.
ALLOW_MOCK_IN_PROD=

# ════════ Тесты ════════

# Тестовая база (тесты её очищают). Compose-режим A: порт 5442 вместо 5432.
TEST_DATABASE_URL=postgresql://autoshorts:autoshorts@127.0.0.1:5432/autoshorts_test

# ════════ Секреты провайдеров: запасной источник ════════
# Основное хранилище — таблица secrets (шифрование Fernet, §8.3). Порядок чтения: БД, затем env
# с тем же именем, затем пусто. Старый конвейер (до M7) читает их только отсюда.

# fal.ai (визуал и премиум-TTS). Пусто — mock (в prod запрещён).
FAL_API_KEY=
# mock | gigachat | openai_compatible
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_REVIEW_CHAT_ID=

# ════════ Legacy-конвейер (queue/worker.py, дашборд, бот до M7-C) ════════

REDIRECT_DOMAIN=u.umka.chat
TELEGRAM_BOT_USERNAME=umka_bot
RENDER_TMP_DIR=./render_tmp
MASTER_ARCHIVE_DIR=./assets/master_archive
FONTS_DIR=./config/fonts
DAILY_BUDGET_USD=15.0
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# ════════ docker compose и режим B (docker-compose.yml, deploy/compose.mode-b.yml, deploy/dev/mode-b.sh) ════════

# uid/gid хозяина файлов в ./var — ваши (id -u, id -g), иначе контейнер пишет чужим uid
AS_UID=1000
AS_GID=1000
# "" или clipping (onnx-asr, onnxruntime, opencv — тяжёлые, ставить по требованию)
AS_PIP_EXTRAS=
# ASGI-приложение редиректора (compose, systemd, mode-b.sh). По умолчанию autoshorts.public.app:app (M3);
# до M3 — хотфикс M0:
# AS_PUBLIC_APP=autoshorts.webapp.redirect:app
# Блочное устройство для лимитов IO тяжёлого воркера в compose (lsblk)
AS_HEAVY_IO_DEVICE=/dev/sda
# Режим B: отдельная база в системном PG16 (не "autoshorts" и не autoshorts_test*) и абсолютный путь медиатеки
AS_DEV_DATABASE_URL=postgresql://autoshorts:autoshorts@127.0.0.1:5432/autoshorts_v1
# AS_DEV_MEDIA_ROOT=/home/<user>/auto-shorts/var/media

# ════════ Смоук (scripts/e2e_smoke.py) и Playwright (web/e2e) ════════
# Учётка для проверок под логином. Лучше отдельный пользователь с ролью viewer.
# AS_SMOKE_LOGIN=
# AS_SMOKE_PASSWORD=
