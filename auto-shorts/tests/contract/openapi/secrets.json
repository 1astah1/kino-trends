{
  "components": {
    "schemas": {
      "ErrorBody": {
        "properties": {
          "code": {
            "description": "Машинный код ошибки, латиница snake_case",
            "examples": [
              "job_not_found"
            ],
            "title": "Code",
            "type": "string"
          },
          "details": {
            "additionalProperties": true,
            "description": "Подробности; для 422 — `errors: [{loc, msg, type}]`",
            "title": "Details",
            "type": "object"
          },
          "message": {
            "description": "Сообщение для человека (по-русски)",
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorResponse": {
        "description": "Единый формат ошибки: `{\"error\": {\"code\", \"message\", \"details\"}}`.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "SecretItem": {
        "properties": {
          "is_set": {
            "title": "Is Set",
            "type": "boolean"
          },
          "last4": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last4"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "source": {
            "anyOf": [
              {
                "enum": [
                  "db",
                  "env"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Откуда берётся значение: БД, env или нигде",
            "title": "Source"
          },
          "updated_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Updated At"
          },
          "used_by": {
            "description": "Ключи провайдеров, продуктов и кустов, которые ссылаются на секрет",
            "items": {
              "type": "string"
            },
            "title": "Used By",
            "type": "array"
          }
        },
        "required": [
          "name",
          "is_set",
          "source",
          "last4",
          "updated_at",
          "used_by"
        ],
        "title": "SecretItem",
        "type": "object"
      },
      "SecretList": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/SecretItem"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "SecretList",
        "type": "object"
      },
      "SecretWrite": {
        "additionalProperties": false,
        "properties": {
          "value": {
            "maxLength": 16384,
            "minLength": 1,
            "title": "Value",
            "type": "string"
          }
        },
        "required": [
          "value"
        ],
        "title": "SecretWrite",
        "type": "object"
      }
    }
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/secrets": {
      "get": {
        "operationId": "secrets_list",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SecretList"
                }
              }
            },
            "description": "Successful Response"
          },
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Ошибка запроса: `{error: {code, message, details}}`"
          },
          "5XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Ошибка сервера или 501 not_implemented"
          }
        },
        "summary": "Секреты: заданы или нет, откуда",
        "tags": [
          "secrets"
        ]
      }
    },
    "/api/v1/secrets/{secret_name}": {
      "delete": {
        "operationId": "secrets_delete",
        "parameters": [
          {
            "description": "Имя секрета, напр. FAL_API_KEY",
            "in": "path",
            "name": "secret_name",
            "required": true,
            "schema": {
              "description": "Имя секрета, напр. FAL_API_KEY",
              "pattern": "^[A-Z][A-Z0-9_]{2,63}$",
              "title": "Secret Name",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Ошибка запроса: `{error: {code, message, details}}`"
          },
          "5XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Ошибка сервера или 501 not_implemented"
          }
        },
        "summary": "Удалить секрет",
        "tags": [
          "secrets"
        ]
      },
      "put": {
        "operationId": "secrets_set",
        "parameters": [
          {
            "description": "Имя секрета, напр. FAL_API_KEY",
            "in": "path",
            "name": "secret_name",
            "required": true,
            "schema": {
              "description": "Имя секрета, напр. FAL_API_KEY",
              "pattern": "^[A-Z][A-Z0-9_]{2,63}$",
              "title": "Secret Name",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SecretWrite"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Ошибка запроса: `{error: {code, message, details}}`"
          },
          "5XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Ошибка сервера или 501 not_implemented"
          }
        },
        "summary": "Записать секрет",
        "tags": [
          "secrets"
        ]
      }
    }
  },
  "tag": "secrets"
}
