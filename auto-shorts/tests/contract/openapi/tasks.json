{
  "components": {
    "schemas": {
      "DeferReason": {
        "enum": [
          "disk_low",
          "load_high",
          "mem_low",
          "budget_exhausted",
          "quota_exhausted"
        ],
        "title": "DeferReason",
        "type": "string"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "description": "Машинный код ошибки, латиница snake_case",
            "examples": [
              "job_not_found"
            ],
            "title": "Code",
            "type": "string"
          },
          "details": {
            "additionalProperties": true,
            "description": "Подробности; для 422 — `errors: [{loc, msg, type}]`",
            "title": "Details",
            "type": "object"
          },
          "message": {
            "description": "Сообщение для человека (по-русски)",
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorResponse": {
        "description": "Единый формат ошибки: `{\"error\": {\"code\", \"message\", \"details\"}}`.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "JobStage": {
        "enum": [
          "script",
          "voice",
          "visuals",
          "clip_fetch",
          "clip_analyze",
          "author_script",
          "author_voice",
          "render",
          "qc",
          "package"
        ],
        "title": "JobStage",
        "type": "string"
      },
      "ResourceClass": {
        "enum": [
          "heavy",
          "light"
        ],
        "title": "ResourceClass",
        "type": "string"
      },
      "Schedule": {
        "properties": {
          "anchor_local_time": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "HH:MM в business_timezone для суточных расписаний",
            "title": "Anchor Local Time"
          },
          "enabled": {
            "title": "Enabled",
            "type": "boolean"
          },
          "interval_sec": {
            "title": "Interval Sec",
            "type": "integer"
          },
          "last_task_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Task Id"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "next_run_at": {
            "format": "date-time",
            "title": "Next Run At",
            "type": "string"
          },
          "payload": {
            "additionalProperties": true,
            "title": "Payload",
            "type": "object"
          },
          "resource_class": {
            "$ref": "#/components/schemas/ResourceClass"
          },
          "task_kind": {
            "title": "Task Kind",
            "type": "string"
          }
        },
        "required": [
          "name",
          "task_kind",
          "resource_class",
          "payload",
          "interval_sec",
          "anchor_local_time",
          "next_run_at",
          "enabled",
          "last_task_id"
        ],
        "title": "Schedule",
        "type": "object"
      },
      "ScheduleList": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Schedule"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "ScheduleList",
        "type": "object"
      },
      "SchedulePatch": {
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Enabled"
          },
          "interval_sec": {
            "anyOf": [
              {
                "minimum": 30.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Interval Sec"
          }
        },
        "title": "SchedulePatch",
        "type": "object"
      },
      "Task": {
        "properties": {
          "attempts": {
            "title": "Attempts",
            "type": "integer"
          },
          "cancel_requested": {
            "title": "Cancel Requested",
            "type": "boolean"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "dedup_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dedup Key"
          },
          "defer_reason": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DeferReason"
              },
              {
                "type": "null"
              }
            ]
          },
          "error_class": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Class"
          },
          "finished_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "heartbeat_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Heartbeat At"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "job_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Job Id"
          },
          "kind": {
            "description": "Вид задачи: job_stage, source_prepare, metrics_poll, … (см. TaskKind)",
            "title": "Kind",
            "type": "string"
          },
          "last_error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Хвост лога ≤ 4 КБ",
            "title": "Last Error"
          },
          "locked_by": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Locked By"
          },
          "max_attempts": {
            "title": "Max Attempts",
            "type": "integer"
          },
          "payload": {
            "additionalProperties": true,
            "title": "Payload",
            "type": "object"
          },
          "priority": {
            "description": "Меньше — раньше",
            "title": "Priority",
            "type": "integer"
          },
          "progress": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "0–100",
            "title": "Progress"
          },
          "resource_class": {
            "$ref": "#/components/schemas/ResourceClass"
          },
          "result": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Result"
          },
          "run_after": {
            "format": "date-time",
            "title": "Run After",
            "type": "string"
          },
          "source_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Id"
          },
          "stage": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/JobStage"
              },
              {
                "type": "null"
              }
            ]
          },
          "started_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "status": {
            "$ref": "#/components/schemas/TaskStatus"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "resource_class",
          "status",
          "priority",
          "run_after",
          "job_id",
          "source_id",
          "stage",
          "payload",
          "dedup_key",
          "attempts",
          "max_attempts",
          "locked_by",
          "heartbeat_at",
          "cancel_requested",
          "progress",
          "started_at",
          "finished_at",
          "error_class",
          "last_error",
          "defer_reason",
          "result",
          "created_at",
          "updated_at"
        ],
        "title": "Task",
        "type": "object"
      },
      "TaskDetail": {
        "properties": {
          "log_tail": {
            "description": "Последние 200 строк лога задачи",
            "items": {
              "type": "string"
            },
            "title": "Log Tail",
            "type": "array"
          },
          "task": {
            "$ref": "#/components/schemas/Task"
          }
        },
        "required": [
          "task",
          "log_tail"
        ],
        "title": "TaskDetail",
        "type": "object"
      },
      "TaskPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Task"
            },
            "title": "Items",
            "type": "array"
          },
          "limit": {
            "title": "Limit",
            "type": "integer"
          },
          "offset": {
            "title": "Offset",
            "type": "integer"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "total",
          "limit",
          "offset",
          "items"
        ],
        "title": "TaskPage",
        "type": "object"
      },
      "TaskStatus": {
        "enum": [
          "queued",
          "running",
          "succeeded",
          "failed",
          "cancelled"
        ],
        "title": "TaskStatus",
        "type": "string"
      },
      "Worker": {
        "properties": {
          "current_task_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Current Task Id"
          },
          "heartbeat_at": {
            "format": "date-time",
            "title": "Heartbeat At",
            "type": "string"
          },
          "hostname": {
            "title": "Hostname",
            "type": "string"
          },
          "id": {
            "description": "<host>-<pid>-<class>",
            "title": "Id",
            "type": "string"
          },
          "pid": {
            "title": "Pid",
            "type": "integer"
          },
          "resource_class": {
            "$ref": "#/components/schemas/ResourceClass"
          },
          "started_at": {
            "format": "date-time",
            "title": "Started At",
            "type": "string"
          },
          "state": {
            "description": "idle | busy | deferred:<reason> | stopping",
            "title": "State",
            "type": "string"
          },
          "version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Version"
          }
        },
        "required": [
          "id",
          "resource_class",
          "hostname",
          "pid",
          "version",
          "started_at",
          "heartbeat_at",
          "current_task_id",
          "state"
        ],
        "title": "Worker",
        "type": "object"
      },
      "WorkerList": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Worker"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "WorkerList",
        "type": "object"
      }
    }
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/schedules": {
      "get": {
        "operationId": "tasks_schedules_list",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScheduleList"
                }
              }
            },
            "description": "Successful Response"
          },
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Ошибка запроса: `{error: {code, message, details}}`"
          },
          "5XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Ошибка сервера или 501 not_implemented"
          }
        },
        "summary": "Расписания",
        "tags": [
          "tasks"
        ]
      }
    },
    "/api/v1/schedules/{schedule_name}": {
      "patch": {
        "operationId": "tasks_schedules_update",
        "parameters": [
          {
            "in": "path",
            "name": "schedule_name",
            "required": true,
            "schema": {
              "pattern": "^[a-z0-9_]{2,63}$",
              "title": "Schedule Name",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SchedulePatch"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Schedule"
                }
              }
            },
            "description": "Successful Response"
          },
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Ошибка запроса: `{error: {code, message, details}}`"
          },
          "5XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Ошибка сервера или 501 not_implemented"
          }
        },
        "summary": "Правка расписания",
        "tags": [
          "tasks"
        ]
      }
    },
    "/api/v1/tasks": {
      "get": {
        "operationId": "tasks_list",
        "parameters": [
          {
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "items": {
                    "$ref": "#/components/schemas/TaskStatus"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            }
          },
          {
            "in": "query",
            "name": "kind",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Kind"
            }
          },
          {
            "in": "query",
            "name": "resource_class",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/ResourceClass"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Resource Class"
            }
          },
          {
            "in": "query",
            "name": "job_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Job Id"
            }
          },
          {
            "in": "query",
            "name": "source_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Source Id"
            }
          },
          {
            "description": "Размер страницы, ≤ 200",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "description": "Размер страницы, ≤ 200",
              "maximum": 200,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "description": "Смещение",
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "description": "Смещение",
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskPage"
                }
              }
            },
            "description": "Successful Response"
          },
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Ошибка запроса: `{error: {code, message, details}}`"
          },
          "5XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Ошибка сервера или 501 not_implemented"
          }
        },
        "summary": "Задачи",
        "tags": [
          "tasks"
        ]
      }
    },
    "/api/v1/tasks/{task_id}": {
      "get": {
        "operationId": "tasks_get",
        "parameters": [
          {
            "in": "path",
            "name": "task_id",
            "required": true,
            "schema": {
              "title": "Task Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskDetail"
                }
              }
            },
            "description": "Successful Response"
          },
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Ошибка запроса: `{error: {code, message, details}}`"
          },
          "5XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Ошибка сервера или 501 not_implemented"
          }
        },
        "summary": "Задача и хвост лога",
        "tags": [
          "tasks"
        ]
      }
    },
    "/api/v1/tasks/{task_id}/cancel": {
      "post": {
        "operationId": "tasks_cancel",
        "parameters": [
          {
            "in": "path",
            "name": "task_id",
            "required": true,
            "schema": {
              "title": "Task Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Task"
                }
              }
            },
            "description": "Successful Response"
          },
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Ошибка запроса: `{error: {code, message, details}}`"
          },
          "5XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Ошибка сервера или 501 not_implemented"
          }
        },
        "summary": "Отменить задачу",
        "tags": [
          "tasks"
        ]
      }
    },
    "/api/v1/tasks/{task_id}/log/stream": {
      "get": {
        "operationId": "tasks_log_stream",
        "parameters": [
          {
            "in": "path",
            "name": "task_id",
            "required": true,
            "schema": {
              "title": "Task Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Строки лога (SSE, `data:` = строка)"
          },
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Ошибка запроса: `{error: {code, message, details}}`"
          },
          "5XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Ошибка сервера или 501 not_implemented"
          }
        },
        "summary": "Живой лог задачи (SSE)",
        "tags": [
          "tasks"
        ]
      }
    },
    "/api/v1/tasks/{task_id}/result-file": {
      "get": {
        "operationId": "tasks_result_file",
        "parameters": [
          {
            "in": "path",
            "name": "task_id",
            "required": true,
            "schema": {
              "title": "Task Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/octet-stream": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              },
              "audio/mpeg": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              }
            },
            "description": "Файл-результат задачи"
          },
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Ошибка запроса: `{error: {code, message, details}}`"
          },
          "5XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Ошибка сервера или 501 not_implemented"
          }
        },
        "summary": "Файл-результат (voice-sample и т. п.)",
        "tags": [
          "tasks"
        ]
      }
    },
    "/api/v1/tasks/{task_id}/retry": {
      "post": {
        "operationId": "tasks_retry",
        "parameters": [
          {
            "in": "path",
            "name": "task_id",
            "required": true,
            "schema": {
              "title": "Task Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
