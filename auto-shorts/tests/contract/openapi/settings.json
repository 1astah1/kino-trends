{
  "components": {
    "schemas": {
      "ErrorBody": {
        "properties": {
          "code": {
            "description": "Машинный код ошибки, латиница snake_case",
            "examples": [
              "job_not_found"
            ],
            "title": "Code",
            "type": "string"
          },
          "details": {
            "additionalProperties": true,
            "description": "Подробности; для 422 — `errors: [{loc, msg, type}]`",
            "title": "Details",
            "type": "object"
          },
          "message": {
            "description": "Сообщение для человека (по-русски)",
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorResponse": {
        "description": "Единый формат ошибки: `{\"error\": {\"code\", \"message\", \"details\"}}`.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "SettingItem": {
        "properties": {
          "default": {
            "title": "Default"
          },
          "description": {
            "title": "Description",
            "type": "string"
          },
          "group": {
            "description": "Группа в UI: general, worker, render, analytics, clipping, qc, …",
            "title": "Group",
            "type": "string"
          },
          "is_overridden": {
            "title": "Is Overridden",
            "type": "boolean"
          },
          "key": {
            "title": "Key",
            "type": "string"
          },
          "updated_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Updated At"
          },
          "value": {
            "description": "Текущее значение (переопределение или дефолт)",
            "title": "Value"
          }
        },
        "required": [
          "key",
          "value",
          "default",
          "description",
          "group",
          "is_overridden",
          "updated_at"
        ],
        "title": "SettingItem",
        "type": "object"
      },
      "SettingsList": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/SettingItem"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "SettingsList",
        "type": "object"
      },
      "SettingsPatch": {
        "additionalProperties": true,
        "description": "`{key: value, …}`; `null` сбрасывает переопределение к дефолту. Только admin.",
        "title": "SettingsPatch",
        "type": "object"
      }
    }
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/settings": {
      "get": {
        "operationId": "settings_list",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingsList"
                }
              }
            },
            "description": "Successful Response"
          },
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Ошибка запроса: `{error: {code, message, details}}`"
          },
          "5XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Ошибка сервера или 501 not_implemented"
          }
        },
        "summary": "Настройки с дефолтами",
        "tags": [
          "settings"
        ]
      },
      "patch": {
        "operationId": "settings_update",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SettingsPatch"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingsList"
                }
              }
            },
            "description": "Successful Response"
          },
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Ошибка запроса: `{error: {code, message, details}}`"
          },
          "5XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Ошибка сервера или 501 not_implemented"
          }
        },
        "summary": "Изменить настройки (admin)",
        "tags": [
          "settings"
        ]
      }
    }
  },
  "tag": "settings"
}
